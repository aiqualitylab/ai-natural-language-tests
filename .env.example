# .env.example
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here

# OTLP provider: grafana, jaeger, datadog, honeycomb, etc.
OTEL_PROVIDER=grafana

# Grafana Cloud OTLP (Traces -> Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <your-base64-token>

# Grafana Loki (Logs)
# Use your Grafana Cloud Logs endpoint, for example:
# https://logs-prod-eu-north-0.grafana.net
GRAFANA_LOKI_URL=https://logs-prod-eu-west-0.grafana.net
GRAFANA_INSTANCE_ID=<your-loki-instance-id>
GRAFANA_API_TOKEN=<your-loki-api-token>

